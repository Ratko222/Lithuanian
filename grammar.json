[{"id":"gender","name":"Gender endings","intro":"Masculine words end in -as/-is/-us and feminine words in -a/-ė, and adjectives must match the noun's gender.","items":[{"q":"Tai raudon______ knyga.","en":"This is a red book.","opts":["as","a","us","ai"],"a":1,"why":"Knyga is feminine, so the adjective ends in -a."},{"q":"Tai didel______ namas.","en":"This is a big house.","opts":["is","ė","į","io"],"a":0,"why":"Namas is masculine, so the adjective is didelis."},{"q":"Mano brolis yra aukšt______.","en":"My brother is tall.","opts":["a","ą","os","as"],"a":3,"why":"Brolis is masculine, so the adjective ends in -as."},{"q":"Mano sesuo yra jaun______.","en":"My sister is young.","opts":["as","us","a","is"],"a":2,"why":"Sesuo is feminine, so the adjective ends in -a."},{"q":"Mano mama labai ger______.","en":"My mom is very good.","opts":["as","a","ą","us"],"a":1,"why":"Mama is feminine, so the adjective ends in -a."},{"q":"Šis stalas yra nauj______.","en":"This table is new.","opts":["as","a","ą","os"],"a":0,"why":"Stalas is masculine, so the adjective ends in -as."},{"q":"Ta mergina yra linksm______.","en":"That girl is cheerful.","opts":["as","us","o","a"],"a":3,"why":"Mergina is feminine, so the adjective ends in -a."},{"q":"Šis vyras yra malon______.","en":"This man is pleasant.","opts":["i","as","us","is"],"a":2,"why":"Vyras is masculine, and this adjective takes the masculine ending -us (feminine: maloni)."},{"q":"Tai mano draug______ Rūta.","en":"This is my (female) friend Rūta.","opts":["as","ė","is","us"],"a":1,"why":"A female friend is draugė; the feminine noun ends in -ė."},{"q":"Tai mano mokytoj______, jis dirba mokykloje.","en":"This is my teacher, he works at a school.","opts":["as","a","ą","ė"],"a":0,"why":"A male teacher is mokytojas; the masculine noun ends in -as."},{"q":"Mano mama yra gydytoj______.","en":"My mom is a doctor.","opts":["as","is","us","a"],"a":3,"why":"A female doctor is gydytoja; the feminine noun ends in -a."},{"q":"Ši gėlė yra balt______.","en":"This flower is white.","opts":["as","us","a","is"],"a":2,"why":"Gėlė is feminine, so the adjective ends in -a."}]},{"id":"byti","name":"To be (būti)","intro":"Present tense of būti: aš esu, tu esi, jis/ji/jie/jos yra, mes esame, jūs esate.","items":[{"q":"Aš ______ studentas.","en":"I am a student.","opts":["esi","esu","yra","esame"],"a":1,"why":"With aš (I) use esu."},{"q":"Tu ______ labai geras.","en":"You are very good.","opts":["esi","esu","yra","esate"],"a":0,"why":"With tu (you, singular) use esi."},{"q":"Jis ______ namie.","en":"He is at home.","opts":["esu","esi","esame","yra"],"a":3,"why":"With jis, ji, jie and jos use yra."},{"q":"Mes ______ Lietuvoje.","en":"We are in Lithuania.","opts":["esate","esu","esame","esi"],"a":2,"why":"With mes (we) use esame."},{"q":"Jūs ______ mokytojai.","en":"You (plural) are teachers.","opts":["esame","esate","esi","esu"],"a":1,"why":"With jūs (you plural/formal) use esate."},{"q":"Jie ______ darbe.","en":"They are at work.","opts":["yra","esame","esate","esu"],"a":0,"why":"With jie (they) use yra."},{"q":"Ji ______ gydytoja.","en":"She is a doctor.","opts":["esu","esi","esate","yra"],"a":3,"why":"With ji (she) use yra."},{"q":"Aš ______ iš Anglijos.","en":"I am from England.","opts":["esi","yra","esu","esate"],"a":2,"why":"With aš (I) use esu."},{"q":"Ar tu ______ pavargęs?","en":"Are you tired?","opts":["esu","esi","yra","esame"],"a":1,"why":"With tu (you, singular) use esi."},{"q":"Mes ______ draugai.","en":"We are friends.","opts":["esame","esu","esi","esate"],"a":0,"why":"With mes (we) use esame."},{"q":"Jūs ______ labai malonūs.","en":"You are very nice.","opts":["esu","esi","yra","esate"],"a":3,"why":"With jūs (you plural/formal) use esate."},{"q":"Mano sesuo ______ namie.","en":"My sister is at home.","opts":["esu","esi","yra","esame"],"a":2,"why":"With a third-person subject like sesuo use yra."},{"q":"Aš ______ laimingas.","en":"I am happy.","opts":["esame","esu","yra","esate"],"a":1,"why":"With aš (I) use esu."},{"q":"Tu ______ mano draugas.","en":"You are my friend.","opts":["esi","esu","esame","esate"],"a":0,"why":"With tu (you, singular) use esi."},{"q":"Mes ______ čia.","en":"We are here.","opts":["yra","esi","esate","esame"],"a":3,"why":"With mes (we) use esame."},{"q":"Jūs ______ iš Lenkijos.","en":"You are from Poland.","opts":["esame","yra","esate","esi"],"a":2,"why":"With jūs (you plural/formal) use esate."}]},{"id":"verbs","name":"Present tense verbs","intro":"Verb endings change with the person: for example turiu, turi, turime, turite for turėti.","items":[{"q":"Aš ______ šunį.","en":"I have a dog.","opts":["turi","turiu","turime","turite"],"a":1,"why":"Aš takes the ending -u: turiu."},{"q":"Tu ______ seserį.","en":"You have a sister.","opts":["turi","turiu","turime","turite"],"a":0,"why":"Tu takes turi."},{"q":"Jis ______ mašiną.","en":"He has a car.","opts":["turiu","turime","turite","turi"],"a":3,"why":"Third person (jis) takes turi."},{"q":"Mes ______ namą.","en":"We have a house.","opts":["turiu","turi","turime","turite"],"a":2,"why":"Mes takes -me: turime."},{"q":"Aš ______ kavos.","en":"I want coffee.","opts":["nori","noriu","norime","norite"],"a":1,"why":"Aš of norėti is noriu."},{"q":"Jūs ______ arbatos.","en":"You want tea.","opts":["norite","noriu","nori","norime"],"a":0,"why":"Jūs takes -te: norite."},{"q":"Ji ______ miegoti.","en":"She wants to sleep.","opts":["noriu","norime","norite","nori"],"a":3,"why":"Third person (ji) is nori."},{"q":"Mes ______ valgyti.","en":"We want to eat.","opts":["noriu","nori","norime","norite"],"a":2,"why":"Mes takes -me: norime."},{"q":"Aš ______ Vilniuje.","en":"I live in Vilnius.","opts":["gyveni","gyvenu","gyvena","gyvename"],"a":1,"why":"Aš of gyventi is gyvenu."},{"q":"Tu ______ Kaune.","en":"You live in Kaunas.","opts":["gyveni","gyvenu","gyvena","gyvename"],"a":0,"why":"Tu of gyventi is gyveni."},{"q":"Jie ______ Lietuvoje.","en":"They live in Lithuania.","opts":["gyvenu","gyveni","gyvename","gyvena"],"a":3,"why":"Third person (jie) is gyvena."},{"q":"Mes ______ mieste.","en":"We live in the city.","opts":["gyvenu","gyveni","gyvename","gyvena"],"a":2,"why":"Mes of gyventi is gyvename."},{"q":"Aš ______ tave.","en":"I love you.","opts":["myli","myliu","mylime","mylite"],"a":1,"why":"Aš of mylėti is myliu."},{"q":"Jūs ______ muziką.","en":"You love music.","opts":["mylite","myliu","myli","mylime"],"a":0,"why":"Jūs of mylėti is mylite."},{"q":"Aš ______ į darbą.","en":"I am going to work.","opts":["eini","eina","einame","einu"],"a":3,"why":"Aš of eiti is einu."},{"q":"Tu ______ į parduotuvę.","en":"You are going to the shop.","opts":["einu","eina","eini","einame"],"a":2,"why":"Tu of eiti is eini."},{"q":"Ji ______ namo.","en":"She is going home.","opts":["einu","eina","eini","einame"],"a":1,"why":"Third person (ji) of eiti is eina."},{"q":"Mes ______ į kiną.","en":"We are going to the cinema.","opts":["einame","einu","eini","eina"],"a":0,"why":"Mes of eiti is einame."},{"q":"Aš ______ biure.","en":"I work in an office.","opts":["dirbi","dirba","dirbame","dirbu"],"a":3,"why":"Aš of dirbti is dirbu."},{"q":"Jūs ______ kartu.","en":"You work together.","opts":["dirbame","dirba","dirbate","dirbu"],"a":2,"why":"Jūs of dirbti is dirbate."}]},{"id":"accusative","name":"Accusative (the object)","intro":"The direct object of verbs like matau, myliu and perku takes the accusative: -ą, -ę, -į, -ų, -us.","items":[{"q":"Matau ______.","en":"I see a cat.","opts":["katą","katę","kate","katės"],"a":1,"why":"Feminine -ė nouns take -ę in the accusative."},{"q":"Aš matau ______.","en":"I see a dog.","opts":["šunį","šuo","šuns","šunys"],"a":0,"why":"The accusative singular of šuo is šunį."},{"q":"Aš myliu ______.","en":"I love my mom.","opts":["mama","mamos","mamai","mamą"],"a":3,"why":"Feminine -a nouns take -ą in the accusative."},{"q":"Aš perku ______.","en":"I am buying bread.","opts":["duona","duonos","duoną","duonai"],"a":2,"why":"Duona becomes duoną in the accusative."},{"q":"Jis perka ______.","en":"He is buying a book.","opts":["knyga","knygą","knygos","knygai"],"a":1,"why":"Knyga becomes knygą in the accusative."},{"q":"Perku ______.","en":"I am buying an apple.","opts":["obuolį","obuolys","obuolio","obuoliai"],"a":0,"why":"Masculine -ys nouns take -į in the accusative."},{"q":"Matau ______.","en":"I see my brother.","opts":["brolis","brolio","broliai","brolį"],"a":3,"why":"Masculine -is nouns take -į in the accusative."},{"q":"Myliu ______.","en":"I love my father.","opts":["tėvas","tėvo","tėvą","tėvai"],"a":2,"why":"Masculine -as nouns take -ą in the accusative."},{"q":"Matau ______.","en":"I see my son.","opts":["sūnus","sūnų","sūnaus","sūnui"],"a":1,"why":"Masculine -us nouns take -ų in the accusative."},{"q":"Matau ______.","en":"I see my sister.","opts":["seserį","sesuo","sesers","seserys"],"a":0,"why":"The accusative singular of sesuo is seserį."},{"q":"Perku ______.","en":"I am buying a table.","opts":["stalas","stalo","stalai","stalą"],"a":3,"why":"Stalas becomes stalą in the accusative."},{"q":"Matau ______.","en":"I see the teacher (female).","opts":["mokytoja","mokytojos","mokytoją","mokytojai"],"a":2,"why":"Feminine -a nouns take -ą in the accusative."},{"q":"Myliu savo ______.","en":"I love my wife.","opts":["žmona","žmoną","žmonos","žmonai"],"a":1,"why":"Žmona becomes žmoną in the accusative."},{"q":"Matau ______.","en":"I see a (female) friend.","opts":["draugę","draugė","draugės","draugei"],"a":0,"why":"Feminine -ė nouns take -ę in the accusative."},{"q":"Aš matau ______.","en":"I see a man.","opts":["vyras","vyro","vyrai","vyrą"],"a":3,"why":"Vyras becomes vyrą in the accusative."},{"q":"Perku ______.","en":"I am buying milk.","opts":["pienas","pieno","pieną","pienai"],"a":2,"why":"Pienas becomes pieną in the accusative."}]},{"id":"plural","name":"Nominative plural","intro":"Plural nominative: -as becomes -ai, -is becomes -iai, -a becomes -os, -ė becomes -ės, and adjectives agree.","items":[{"q":"Šie ______ yra nauji.","en":"These tables are new.","opts":["stalas","stalai","stalus","stalų"],"a":1,"why":"Masculine -as becomes -ai in the plural."},{"q":"Mano ______ gyvena Vilniuje.","en":"My friends live in Vilnius.","opts":["draugai","draugas","draugus","draugų"],"a":0,"why":"Masculine -as becomes -ai in the plural."},{"q":"Šios ______ labai gražios.","en":"These flowers are very beautiful.","opts":["gėlė","gėles","gėlių","gėlės"],"a":3,"why":"Feminine -ė becomes -ės in the plural."},{"q":"Tos ______ yra mažos.","en":"Those cats are small.","opts":["katė","katę","katės","kačių"],"a":2,"why":"Feminine -ė becomes -ės in the plural."},{"q":"______ yra namie.","en":"The children are at home.","opts":["Vaikas","Vaikai","Vaikus","Vaikų"],"a":1,"why":"Masculine -as becomes -ai in the plural."},{"q":"Mano ______ dirba.","en":"My brothers work.","opts":["broliai","brolis","brolį","brolių"],"a":0,"why":"Masculine -is becomes -iai in the plural."},{"q":"Šie vyrai yra aukšt______.","en":"These men are tall.","opts":["as","os","us","i"],"a":3,"why":"A masculine plural adjective ends in -i."},{"q":"Tos mergaitės yra jaun______.","en":"Those girls are young.","opts":["as","i","os","us"],"a":2,"why":"A feminine plural adjective ends in -os."},{"q":"Šie namai yra didel______.","en":"These houses are big.","opts":["is","i","ės","ius"],"a":1,"why":"A masculine plural adjective ends in -i: dideli."},{"q":"Mūsų ______ yra geri.","en":"Our teachers are good.","opts":["mokytojai","mokytojas","mokytoją","mokytojų"],"a":0,"why":"Masculine -as becomes -ai in the plural."},{"q":"Mano ______ gyvena Kaune.","en":"My sisters live in Kaunas.","opts":["sesuo","seserį","seserų","seserys"],"a":3,"why":"The plural of sesuo is seserys."},{"q":"Tie ______ yra geri.","en":"Those people are good.","opts":["žmogus","žmogų","žmonės","žmonių"],"a":2,"why":"The plural of žmogus is žmonės."}]},{"id":"questions","name":"Question words","intro":"Kas = who/what, kur = where, kada = when, kaip = how, kodėl = why, kiek = how much/many, kuris = which.","items":[{"q":"______ tai? Tai mano brolis.","en":"Who is this? This is my brother.","opts":["Kur","Kas","Kada","Kaip"],"a":1,"why":"Kas asks who or what."},{"q":"______ tu gyveni? Vilniuje.","en":"Where do you live? In Vilnius.","opts":["Kur","Kas","Kada","Kodėl"],"a":0,"why":"Kur asks where."},{"q":"______ jūs atvykstate? Rytoj.","en":"When are you arriving? Tomorrow.","opts":["Kur","Kaip","Kiek","Kada"],"a":3,"why":"Kada asks when."},{"q":"______ tau sekasi? Gerai.","en":"How are you doing? Well.","opts":["Kas","Kur","Kaip","Kodėl"],"a":2,"why":"Kaip asks how."},{"q":"______ tu verki? Nes man liūdna.","en":"Why are you crying? Because I am sad.","opts":["Kada","Kodėl","Kur","Kiek"],"a":1,"why":"Kodėl asks why."},{"q":"______ tai kainuoja? Penkis eurus.","en":"How much does this cost? Five euros.","opts":["Kiek","Kas","Kur","Kodėl"],"a":0,"why":"Kiek asks how much or how many."},{"q":"______ knygą nori? Šitą.","en":"Which book do you want? This one.","opts":["Kuris","Kuri","Kurį","Kurią"],"a":3,"why":"Kuris agrees with knyga: feminine accusative kurią."},{"q":"______ yra tavo vardas?","en":"What is your name?","opts":["Kur","Kada","Koks","Kodėl"],"a":2,"why":"Koks asks what kind of; it is used for names and descriptions."},{"q":"______ dabar valandų?","en":"What time is it now?","opts":["Kas","Kiek","Kur","Kodėl"],"a":1,"why":"Time is asked with kiek valandų."},{"q":"______ tu eini? Į darbą.","en":"Where are you going? To work.","opts":["Kur","Kada","Kas","Kodėl"],"a":0,"why":"Kur asks where, including where to."},{"q":"______ iš jų yra tavo brolis?","en":"Which of them is your brother?","opts":["Kur","Kada","Kiek","Kuris"],"a":3,"why":"Kuris asks which one among several."},{"q":"______ tu mokaisi lietuvių kalbos?","en":"Why are you learning Lithuanian?","opts":["Kur","Kada","Kodėl","Kiek"],"a":2,"why":"Kodėl asks why."}]},{"id":"numbers","name":"Numbers and nouns","intro":"After vienas use singular, after 2 to 9 use nominative plural, and after 10 to 20 use genitive plural.","items":[{"q":"Ant stalo yra vienas ______.","en":"There is one apple on the table.","opts":["obuoliai","obuolys","obuolių","obuolį"],"a":1,"why":"After vienas the noun is singular."},{"q":"Ant stalo yra du ______.","en":"There are two apples on the table.","opts":["obuoliai","obuolys","obuolių","obuolį"],"a":0,"why":"After 2 to 9 use the nominative plural."},{"q":"Ant stalo yra dešimt ______.","en":"There are ten apples on the table.","opts":["obuoliai","obuolys","obuolį","obuolių"],"a":3,"why":"After 10 use the genitive plural."},{"q":"Ant stalo yra trys ______.","en":"There are three apples on the table.","opts":["obuolys","obuolių","obuoliai","obuolį"],"a":2,"why":"After 2 to 9 use the nominative plural."},{"q":"Klasėje yra penki ______.","en":"There are five children in the class.","opts":["vaikų","vaikai","vaikas","vaiką"],"a":1,"why":"After 2 to 9 use the nominative plural."},{"q":"Klasėje yra dvylika ______.","en":"There are twelve children in the class.","opts":["vaikų","vaikai","vaikas","vaiką"],"a":0,"why":"After 10 to 20 use the genitive plural."},{"q":"Turiu vieną ______.","en":"I have one sister.","opts":["sesuo","seserys","seserų","seserį"],"a":3,"why":"After vienas the noun is singular, here in the accusative."},{"q":"Turiu dvi ______.","en":"I have two sisters.","opts":["sesuo","seserų","seseris","seserys"],"a":2,"why":"After 2 to 9 the object is in the accusative plural."},{"q":"Yra dvidešimt ______.","en":"There are twenty students.","opts":["studentai","studentų","studentas","studentus"],"a":1,"why":"After 20 use the genitive plural."},{"q":"Namie yra vienas ______.","en":"There is one dog at home.","opts":["šuo","šunys","šunų","šunį"],"a":0,"why":"After vienas the noun is singular."},{"q":"Matau du ______.","en":"I see two dogs.","opts":["šunys","šunų","šuo","šunis"],"a":3,"why":"After 2 to 9 the object is in the accusative plural."},{"q":"Čia yra šeši ______.","en":"There are six tables here.","opts":["stalas","stalų","stalai","stalą"],"a":2,"why":"After 2 to 9 use the nominative plural."}]},{"id":"prepositions","name":"Prepositions and cases","intro":"Į takes the accusative, iš/be/ant/prie take the genitive, and su takes the instrumental.","items":[{"q":"Einu į ______.","en":"I am going to school.","opts":["mokykloje","mokyklą","mokyklos","mokykla"],"a":1,"why":"Į takes the accusative."},{"q":"Aš esu iš ______.","en":"I am from Lithuania.","opts":["Lietuvos","Lietuva","Lietuvą","Lietuvoje"],"a":0,"why":"Iš takes the genitive."},{"q":"Kavą geriu su ______.","en":"I drink coffee with milk.","opts":["pienas","pieno","pieną","pienu"],"a":3,"why":"Su takes the instrumental."},{"q":"Kava be ______.","en":"Coffee without sugar.","opts":["cukrus","cukrų","cukraus","cukrumi"],"a":2,"why":"Be takes the genitive."},{"q":"Knyga yra ant ______.","en":"The book is on the table.","opts":["stalas","stalo","stalą","stalu"],"a":1,"why":"Ant takes the genitive."},{"q":"Po ______ einu į darbą.","en":"After lunch I go to work.","opts":["pietų","pietūs","pietus","pietumis"],"a":0,"why":"Po meaning after takes the genitive."},{"q":"Jis stovi prie ______.","en":"He is standing by the door.","opts":["durys","duris","duryse","durų"],"a":3,"why":"Prie takes the genitive."},{"q":"Važiuoju į ______.","en":"I am travelling to Vilnius.","opts":["Vilnius","Vilniaus","Vilnių","Vilniuje"],"a":2,"why":"Į takes the accusative."},{"q":"Einu su ______.","en":"I am going with a friend.","opts":["draugas","draugu","draugo","draugą"],"a":1,"why":"Su takes the instrumental."},{"q":"Grįžtu iš ______.","en":"I am returning from work.","opts":["darbo","darbas","darbą","darbu"],"a":0,"why":"Iš takes the genitive."},{"q":"Kalbu su ______.","en":"I am talking with mom.","opts":["mamą","mamos","mamai","mama"],"a":3,"why":"Su takes the instrumental, and for mama that form is mama."},{"q":"Sėdžiu prie ______.","en":"I am sitting by the window.","opts":["langas","langą","lango","langu"],"a":2,"why":"Prie takes the genitive."}]}]